# --- core ----------------------------------------------------------------------------------
HIMSAT_ENV=prod
POSTGRES_PASSWORD=change-me
HIMSAT_PUBLIC_BASE_URL=https://himsat.example.org
HIMSAT_LOG_JSON=true
# sha256 hashes of admin API keys (create with: himsat admin new-key), comma separated
HIMSAT_ADMIN_API_KEYS=
HIMSAT_CORS_ORIGINS=https://himsat.example.org

# --- alerting ------------------------------------------------------------------------------
HIMSAT_DISPATCH_ENABLED=true
# levels sent without human review; others wait in the review queue
HIMSAT_AUTO_DISPATCH_LEVELS=high
HIMSAT_EMERGENCY_HOTLINE=100
HIMSAT_SMS_PROVIDER=none            # none | sparrow | twilio
HIMSAT_SPARROW_TOKEN=
HIMSAT_SPARROW_FROM=
HIMSAT_TWILIO_ACCOUNT_SID=
HIMSAT_TWILIO_AUTH_TOKEN=
HIMSAT_TWILIO_FROM=
HIMSAT_SMTP_HOST=
HIMSAT_SMTP_PORT=587
HIMSAT_SMTP_USER=
HIMSAT_SMTP_PASSWORD=
HIMSAT_SMTP_FROM=alerts@himsat.example.org
HIMSAT_WEBHOOK_SECRET=

# --- self-hosted LLM (OpenAI-compatible) ---------------------------------------------------
HIMSAT_LLM_BACKEND=openai           # openai | none (template-only alerts)
HIMSAT_LLM_BASE_URL=http://ollama:11434/v1
HIMSAT_LLM_MODEL=qwen2.5:7b-instruct
# languages the LLM may write (others use the reviewed templates). Add "ne" only after native-speaker
# evaluation of your model: 7-8B models wrote incorrect Nepali in testing.
HIMSAT_LLM_LANGUAGES=en

# --- AI models -----------------------------------------------------------------------------
# Benchmark (docs/MODEL_CARD.md): rules+SAM gave the most accurate lake areas; Prithvi adds
# debris-covered ice. Prithvi/SAM need the ML image: docker compose build --build-arg EXTRAS="postgres,ml"
HIMSAT_SEGMENTER=spectral           # auto | spectral | prithvi
HIMSAT_PRITHVI_CHECKPOINT=/models/prithvi-himsat-v1.pt
HIMSAT_SAM_MODEL=                   # e.g. facebook/sam-vit-base
HIMSAT_DEVICE=auto

# --- scheduling ----------------------------------------------------------------------------
HIMSAT_SCHEDULE_INTERVAL_MINUTES=180
